# Copy to .env and adjust: cp .env.example .env
# .env is git-ignored; never commit real secrets.

# Run Airflow containers as your user so files in dags/ and logs/ stay yours.
# On Linux/WSL set this to the output of `id -u`.
AIRFLOW_UID=1000

# Airflow image; the default in docker-compose.yaml is the pinned version.
# AIRFLOW_IMAGE_NAME=apache/airflow:3.4.0

# Admin account created on first start (UI login).
_AIRFLOW_WWW_USER_USERNAME=airflow
_AIRFLOW_WWW_USER_PASSWORD=airflow

# Encrypts connection passwords and variables in the metadata DB. Generate one with:
#   docker compose run --rm airflow-cli python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Set it before storing connections; changing it later makes existing secrets unreadable.
FERNET_KEY=

# Signs the tokens tasks use to talk to the Task Execution API. Any long random string.
# AIRFLOW__API_AUTH__JWT_SECRET=
